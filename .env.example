# Optional real AI. With no key, the UI labels demo recommendation logic.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set AI_PROVIDER=demo to explicitly use deterministic local logic.

# SANDBOX credentials only. Never use live credentials.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

APP_ORIGIN=http://localhost:3000
PORT=3000
